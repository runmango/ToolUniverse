# Optional credentials. Public tools such as UniProt work without a key.
# Copy this file to .env. The local launchers load it automatically.
# Full upstream credential list: .env.template
# NCBI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# SEMANTIC_SCHOLAR_API_KEY=
# TOOLUNIVERSE_API_TOKEN=
# TOOLUNIVERSE_CODEX_PATH=C:\path\to\codex.exe
